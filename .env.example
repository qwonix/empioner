# Copy to /etc/empioner/prod.env, chmod 600. Never commit actual credentials.
# Single-quote values containing $ to prevent Compose interpolation.
POSTGRES_DB=empioner
POSTGRES_USER=empioner
POSTGRES_PASSWORD=replace-postgres-password
POSTGRES_EXPORTER_PASSWORD=replace-postgres-monitor-password
# Keep the actual old application DB name for migration (previous default: test).
MONGODB_DATABASE=test
MONGODB_ROOT_USER=empioner_root
MONGODB_ROOT_PASSWORD=replace-mongo-root-password
MONGODB_USER=empioner
MONGODB_PASSWORD=replace-mongo-app-password
MONGODB_EXPORTER_PASSWORD=replace-mongo-monitor-password
REDIS_USER=empioner
REDIS_USER_PASSWORD=replace-redis-app-password
REDIS_EXPORTER_PASSWORD=replace-redis-monitor-password
EMPIONER_SERVICE_USERNAME=empioner_bot
EMPIONER_SERVICE_PASSWORD=replace-internal-api-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-grafana-password
BOT_TITLE=Empioner
BOT_DESCRIPTION=Empioner
BOT_USERNAME=replace_bot_username
BOT_TOKEN=replace-telegram-token
BOT_CONFIG_IMAGE_PLACEHOLDER=00000000-0000-0000-0000-000000000001
BOT_CONFIG_SHOW_SHOW_IMAGE_ID=00000000-0000-0000-0000-000000000002
BOT_CONFIG_SHOW_SERIES_IMAGE_ID=00000000-0000-0000-0000-000000000003
BOT_CONFIG_SHOW_SPECIAL_IMAGE_ID=
BOT_CONFIG_SHOW_MOVIE_IMAGE_ID=00000000-0000-0000-0000-000000000004
BOT_SINGLE_SHOW_MODE_SHOW_ID=
# Bootstrap apps requires registry digests, e.g. repository@sha256:...
BOT_IMAGE=qwonix/empioner-telegram-bot:unconfigured
SERVICE_IMAGE=qwonix/empioner-telegram-service:unconfigured
