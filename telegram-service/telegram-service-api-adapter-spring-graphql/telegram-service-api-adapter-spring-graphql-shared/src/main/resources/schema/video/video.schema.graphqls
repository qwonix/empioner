scalar Long
scalar VideoId
scalar VideoGroupId
scalar TelegramFileId
scalar TelegramFileUniqueId

type VideoInput {
    id: VideoId!
    videoGroupId: VideoGroupId!
    description: String!
    telegramFileId: TelegramFileId!
    telegramFileUniqueId: TelegramFileUniqueId!
    priority: Int!
    isAvailable: Boolean!
}

input AddVideoInput {
    telegramFileId: TelegramFileId!
    telegramFileUniqueId: TelegramFileUniqueId!
    width: Int
    height: Int
    duration: Int
    mimeType: String
    fileSize: Int
    fileName: String
}

input EpisodeVideoDetailsInput {
    width: Int!
    height: Int!
    duration: Int!
    mimeType: String!
    fileSize: Long!
    fileName: String!
}

type EpisodeVideoDetails {
    width: Int!
    height: Int!
    duration: Int!
    mimeType: String!
    fileSize: Long!
    fileName: String!
}

input CreateEpisodeVideoInput {
    description: String!
    telegramFileId: TelegramFileId!
    telegramFileUniqueId: TelegramFileUniqueId!
    priority: Int!
    isAvailable: Boolean!
    details: EpisodeVideoDetailsInput
}

input UpdateVideoInput {
    description: String
    telegramFileId: TelegramFileId
    telegramFileUniqueId: TelegramFileUniqueId
    priority: Int
    isAvailable: Boolean
    details: EpisodeVideoDetailsInput
}
