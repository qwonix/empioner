input CreateEpisodeInput {
    seasonId: SeasonId!
    title: String!
    description: String!
    number: Int!
}

extend type Mutation {
    createEpisode(input: CreateEpisodeInput!): EpisodeInput!
    publishEpisode(id: EpisodeId!): Boolean!
    unpublishEpisode(id: EpisodeId!): Boolean!
    changeAvailable(id: EpisodeId!, isAvailable: Boolean!): Boolean
}
