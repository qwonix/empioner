<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">
    <changeSet id="2026-11-13-episode-navigation" author="empioner">
        <sql>COMMENT ON COLUMN episode.previous_episode_id IS 'Deprecated: navigation is derived from published episodes in the series';</sql>
        <sql>COMMENT ON COLUMN episode.next_episode_id IS 'Deprecated: navigation is derived from published episodes in the series';</sql>
        <createIndex tableName="season" indexName="idx_season_series_navigation">
            <column name="series_id"/><column name="number"/><column name="id"/>
        </createIndex>
        <createIndex tableName="episode" indexName="idx_episode_season_navigation">
            <column name="season_id"/><column name="is_available"/><column name="number"/><column name="id"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="idx_episode_season_navigation" tableName="episode"/>
            <dropIndex indexName="idx_season_series_navigation" tableName="season"/>
            <sql>COMMENT ON COLUMN episode.previous_episode_id IS NULL;</sql>
            <sql>COMMENT ON COLUMN episode.next_episode_id IS NULL;</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
